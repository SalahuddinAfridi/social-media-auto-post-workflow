      "name": "Fetch Content Sitemap"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.data ?? '');\n\nconst urls = [...raw.matchAll(/<url>[\\s\\S]*?<loc>\\s*(https:\\/\\/www\\.placidway\\.com\\/[^<]+)<\\/loc>([\\s\\S]*?)<\\/url>/g)];\n\nreturn urls.map(match => {\n  const block = match[0];\n  const url = match[1].trim();\n  const imageMatch = block.match(/<image:loc>\\s*([\\s\\S]*?)\\s*<\\/image:loc>/);\n\n  return {\n    json: {\n      url,\n      image: imageMatch ? imageMatch[1].trim() : ''\n    }\n  };\n});"
      },
