    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a Facebook post using the following PlacidWay page information.\n\nTitle: {{ $json.title }}\nSummary: {{ $json.summary }}\nURL: {{ $json.url }}\n\nRequirements:\n- Write an engaging, professional Facebook post under 500 characters, excluding the URL.\n- Start with an interesting hook.\n- Explain the value of the page using only the supplied information.\n- Include a clear call to action.\n- Include the provided URL.\n- Add 3–5 relevant hashtags.\n- Do not make medical claims, promise outcomes, invent prices, or add unsupported facts.\n- Return only the final Facebook post text.",
        "messages": {
          "messageValues": []
        },
        "batching": {}
