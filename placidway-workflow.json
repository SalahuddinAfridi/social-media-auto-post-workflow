    },
    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.data ?? '');\n\nconst urls = [...raw.matchAll(/<loc>\\s*(https:\\/\\/www\\.placidway\\.com\\/[^<]+)<\\/loc>/g)]\n  .map(match => match[1].trim());\n\nreturn urls.map(url => ({\n  json: { sitemapUrl: url }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
