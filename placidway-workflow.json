    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const title = $json.title || '';\nconst url = $json.url || '';\nconst summary = $json.summary || '';\nconst image = $json.image || '';\n\nconst post = `🌍 Discover insights from PlacidWay!\n\n${title}\n\n${summary}\n\nLearn more here: ${url}\n\n#PlacidWay #MedicalTourism #HealthcareInsights`;\n\nreturn {\n  json: {\n    title,\n    url,\n    summary,\n    image,\n    post\n  }\n};"
      },
